import * as XLSX from 'xlsx'
import { format, parseISO } from 'date-fns'
import { pt } from 'date-fns/locale'
import {
  groupPunchesByDay,
  calculateDayHours,
  formatHours,
  calculateDailyOvertime,
  STANDARD_HOURS_PER_DAY
} from './calculations'

function getEmployeeName(employees, id) {
  return employees.find(e => e.id === id)?.name || 'Desconhecido'
}

export function exportToExcel(punches, employees, filename = 'ponto-digital') {
  const wb = XLSX.utils.book_new()

  // ── Folha 1: Todas as Picagens ──────────────────────────────────────
  const punchRows = [...punches]
    .sort((a, b) => new Date(b.timestamp) - new Date(a.timestamp))
    .map(p => ({
      'Colaborador': getEmployeeName(employees, p.employee_id),
      'Data': format(parseISO(p.timestamp), 'dd/MM/yyyy'),
      'Hora': format(parseISO(p.timestamp), 'HH:mm:ss'),
      'Tipo': p.type === 'entrada' ? '▼ Entrada' : '▲ Saída',
    }))

  const ws1 = XLSX.utils.json_to_sheet(punchRows)
  styleSheet(ws1, [20, 14, 12, 12])
  XLSX.utils.book_append_sheet(wb, ws1, 'Picagens')

  // ── Folha 2: Resumo Diário ──────────────────────────────────────────
  const dailyRows = []

  for (const emp of employees) {
    const empPunches = punches.filter(p => p.employee_id === emp.id)
    const byDay = groupPunchesByDay(empPunches)

    for (const [day, dp] of Object.entries(byDay)) {
      const sorted = [...dp].sort((a, b) => new Date(a.timestamp) - new Date(b.timestamp))
      const hours = calculateDayHours(dp)
      const overtime = calculateDailyOvertime(hours)
      const firstEntry = sorted.find(p => p.type === 'entrada')
      const lastExit = [...sorted].reverse().find(p => p.type === 'saida')

      dailyRows.push({
        'Colaborador': emp.name,
        'Data': format(new Date(day + 'T12:00:00'), 'dd/MM/yyyy'),
        'Dia': format(new Date(day + 'T12:00:00'), 'EEEE', { locale: pt }),
        'Entrada': firstEntry ? format(parseISO(firstEntry.timestamp), 'HH:mm') : '—',
        'Saída': lastExit ? format(parseISO(lastExit.timestamp), 'HH:mm') : '⚠ Em falta',
        'Horas Trabalhadas': formatHours(hours),
        'Standard': `${STANDARD_HOURS_PER_DAY}h00m`,
        'Horas Extra': overtime > 0 ? `+${formatHours(overtime)}` : '—',
        'Nº Picagens': dp.length,
      })
    }
  }

  dailyRows.sort((a, b) => {
    if (a['Colaborador'] !== b['Colaborador']) return a['Colaborador'].localeCompare(b['Colaborador'])
    return b['Data'].localeCompare(a['Data'])
  })

  const ws2 = XLSX.utils.json_to_sheet(dailyRows)
  styleSheet(ws2, [20, 12, 14, 10, 10, 18, 12, 14, 12])
  XLSX.utils.book_append_sheet(wb, ws2, 'Resumo Diário')

  // ── Folha 3: Resumo Mensal ──────────────────────────────────────────
  const monthlyRows = []

  for (const emp of employees) {
    const empPunches = punches.filter(p => p.employee_id === emp.id)
    const byDay = groupPunchesByDay(empPunches)

    // Agrupar por mês
    const byMonth = {}
    for (const [day, dp] of Object.entries(byDay)) {
      const month = day.substring(0, 7)
      if (!byMonth[month]) byMonth[month] = { hours: 0, days: 0, overtime: 0 }
      const h = calculateDayHours(dp)
      byMonth[month].hours += h
      byMonth[month].overtime += calculateDailyOvertime(h)
      if (h > 0) byMonth[month].days++
    }

    for (const [month, data] of Object.entries(byMonth)) {
      monthlyRows.push({
        'Colaborador': emp.name,
        'Mês': format(new Date(month + '-01'), 'MMMM yyyy', { locale: pt }),
        'Dias Trabalhados': data.days,
        'Total Horas': formatHours(data.hours),
        'Horas Extra': data.overtime > 0 ? `+${formatHours(data.overtime)}` : '—',
        'Média Diária': data.days > 0 ? formatHours(data.hours / data.days) : '—',
      })
    }
  }

  monthlyRows.sort((a, b) => {
    if (a['Colaborador'] !== b['Colaborador']) return a['Colaborador'].localeCompare(b['Colaborador'])
    return b['Mês'].localeCompare(a['Mês'])
  })

  const ws3 = XLSX.utils.json_to_sheet(monthlyRows)
  styleSheet(ws3, [20, 16, 16, 14, 14, 14])
  XLSX.utils.book_append_sheet(wb, ws3, 'Resumo Mensal')

  // Exportar
  const date = format(new Date(), 'yyyy-MM-dd')
  XLSX.writeFile(wb, `${filename}-${date}.xlsx`)
}

// Definir largura das colunas
function styleSheet(ws, colWidths) {
  ws['!cols'] = colWidths.map(w => ({ wch: w }))
}
